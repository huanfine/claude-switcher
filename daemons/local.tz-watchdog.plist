<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd 模板: 安装到 /Library/LaunchDaemons;脚本在 root 所有的 /Library/Application Support/claude-switcher/ 下(用户态不可写,防提权) -->
<plist version="1.0"><dict>
	<key>Label</key><string>local.tz-watchdog</string>
	<key>ProgramArguments</key><array><string>/bin/bash</string><string>/Library/Application Support/claude-switcher/tz-watchdog.sh</string></array>
	<!-- 5 分钟一次:macOS 的「按定位自动设置时区」随时会把 /etc/localtime 改回去,
	     一小时一次的窗口意味着用户可能整小时都顶着错误的时区在用 Claude -->
	<key>StartInterval</key><integer>300</integer>
	<key>RunAtLoad</key><true/>
</dict></plist>
